    /**
     * Test 9: Enhanced status command - Table filter
     */
    public function testStatusCommandTableFilter(): void
    {
        $configFile = $this->testProjectDir . '/config.php';
        require $configFile;
        if (!isset($config) || !is_array($config)) {
            $this->fail('Config file did not set $config variable properly');
        }
        $baseDb = new DataBase($config);
        $baseDb->connect();
        
        require_once __DIR__ . '/../../../src/Utils/MigrationHelper.php';
        \Reut\Utils\MigrationHelper::ensureMigrationsTable($baseDb);
        
        // Add migrations for different tables
        $baseDb->execute(
            "INSERT INTO migrations (name, sql_text, batch) VALUES (:name, :sql_text, :batch)",
            ['name' => 'create_users_table_20240101', 'sql_text' => 'CREATE TABLE users (id INT)', 'batch' => 1]
        );
        $baseDb->execute(
            "INSERT INTO migrations (name, sql_text, batch) VALUES (:name, :sql_text, :batch)",
            ['name' => 'create_posts_table_20240101', 'sql_text' => 'CREATE TABLE posts (id INT)', 'batch' => 1]
        );
        
        $result = $this->runCommand('status --table=users');
        
        // Should only show users migrations
        $this->assertStringContainsString('users', $result['output']);
        $this->assertStringNotContainsString('posts', $result['output']);
    }

    /**
     * Test 10: Dry-run mode for migrate command
     */
    public function testMigrateDryRunMode(): void
    {
        // Create a model
        $this->createTestModel('Products', [
            'id' => 'INT PRIMARY KEY AUTO_INCREMENT',
            'name' => 'VARCHAR(255)',
        ]);
        
        // scaffoldTestProject will copy the model
        $result = $this->runCommand('migrate --dry-run');
        
        // Should show DRY-RUN messages
        $this->assertStringContainsString('DRY-RUN', $result['output']);
        $this->assertStringContainsString('No changes were made', $result['output']);
        
        // Table should not exist (dry-run doesn't execute)
        $configFile = $this->testProjectDir . '/config.php';
        require $configFile;
        if (!isset($config) || !is_array($config)) {
            $this->fail('Config file did not set $config variable properly');
        }
        $baseDb = new DataBase($config);
        $baseDb->connect();
        
        $tables = $baseDb->getTablesList();
        $this->assertNotContains('products', $tables);
    }

    /**
     * Test 11: Dry-run mode for sync command
     */
    public function testSyncDryRunMode(): void
    {
        // Create table in database
        $this->pdo->exec("CREATE TABLE products (id INT PRIMARY KEY AUTO_INCREMENT, name VARCHAR(255), old_column VARCHAR(100))");
        
        // Create model without old_column
        $this->createTestModel('Products', [
            'id' => 'INT PRIMARY KEY AUTO_INCREMENT',
            'name' => 'VARCHAR(255)',
        ]);
        
        // scaffoldTestProject will copy the model
        $result = $this->runCommand('sync --dry-run');
        
        // Should show DRY-RUN messages
        $this->assertStringContainsString('DRY-RUN', $result['output']);
        $this->assertStringContainsString('No changes were made', $result['output']);
        
        // Column should still exist (dry-run doesn't execute)
        $configFile = $this->testProjectDir . '/config.php';
        require $configFile;
        if (!isset($config) || !is_array($config)) {
            $this->fail('Config file did not set $config variable properly');
        }
        $baseDb = new DataBase($config);
        $baseDb->connect();
        
        $columns = $baseDb->sqlQuery("SHOW COLUMNS FROM products");
        $columnNames = array_column($columns, 'Field');
        $this->assertContains('old_column', $columnNames);
    }

