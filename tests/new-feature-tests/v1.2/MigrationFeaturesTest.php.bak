        require_once __DIR__ . '/../../../src/Utils/MigrationHelper.php';
        \Reut\Utils\MigrationHelper::ensureMigrationsTable($baseDb);
        
        // Create a table
        $this->pdo->exec("CREATE TABLE test_rollback (id INT PRIMARY KEY)");
        
        // Add migration
        $baseDb->execute(
            "INSERT INTO migrations (name, sql_text, batch) VALUES (:name, :sql_text, :batch)",
            ['name' => 'create_test_rollback_table_20240101', 'sql_text' => 'CREATE TABLE test_rollback (id INT PRIMARY KEY)', 'batch' => 1]
        );
        
        // Test dry-run rollback
        $result = $this->runCommand('rollback --dry-run');
        
        // Should show rollback plan
        $this->assertStringContainsString('Rollback Plan', $result['output']);
        $this->assertStringContainsString('DRY-RUN', $result['output']);
        
        // Table should still exist
        $tables = $baseDb->getTablesList();
        $this->assertContains('test_rollback', $tables);
    }

    /**
     * Test 13: Migration rollback command - Specific batch
     */
    public function testRollbackSpecificBatch(): void
    {
        $configFile = $this->testProjectDir . '/config.php';
        require $configFile;
        if (!isset($config) || !is_array($config)) {
            $this->fail('Config file did not set $config variable properly');
        }
        $baseDb = new DataBase($config);
        $baseDb->connect();
        
        require_once __DIR__ . '/../../../src/Utils/MigrationHelper.php';
        \Reut\Utils\MigrationHelper::ensureMigrationsTable($baseDb);
        
        // Add migrations in different batches
        $baseDb->execute(
            "INSERT INTO migrations (name, sql_text, batch) VALUES (:name, :sql_text, :batch)",
            ['name' => 'migration_batch_1', 'sql_text' => 'CREATE TABLE batch1 (id INT)', 'batch' => 1]
        );
        $baseDb->execute(
            "INSERT INTO migrations (name, sql_text, batch) VALUES (:name, :sql_text, :batch)",
            ['name' => 'migration_batch_2', 'sql_text' => 'CREATE TABLE batch2 (id INT)', 'batch' => 2]
        );
        
        $result = $this->runCommand('rollback --batch=2 --dry-run');
        
        // Should show batch 2 migrations
        $this->assertStringContainsString('migration_batch_2', $result['output']);
    }

    /**
     * Test 14: Migration validation command
     */
    public function testValidateMigrations(): void
    {
        $configFile = $this->testProjectDir . '/config.php';
        require $configFile;
        if (!isset($config) || !is_array($config)) {
            $this->fail('Config file did not set $config variable properly');
        }
        $baseDb = new DataBase($config);
        $baseDb->connect();
        
        require_once __DIR__ . '/../../../src/Utils/MigrationHelper.php';
        \Reut\Utils\MigrationHelper::ensureMigrationsTable($baseDb);
        
        // Add valid migration
        $baseDb->execute(
            "INSERT INTO migrations (name, sql_text, batch) VALUES (:name, :sql_text, :batch)",
            ['name' => 'valid_migration', 'sql_text' => 'CREATE TABLE valid (id INT PRIMARY KEY)', 'batch' => 1]
        );
        
        // Add potentially problematic migration (DROP COLUMN)
        $baseDb->execute(
            "INSERT INTO migrations (name, sql_text, batch) VALUES (:name, :sql_text, :batch)",
            ['name' => 'drop_column_migration', 'sql_text' => 'ALTER TABLE valid DROP COLUMN old_col', 'batch' => 1]
        );
        
        $result = $this->runCommand('validate-migrations');
        
        // Should validate migrations
        $this->assertStringContainsString('Validation Results', $result['output']);
        $this->assertStringContainsString('Validated', $result['output']);
        
        // Should warn about DROP COLUMN
        $this->assertStringContainsString('DROP COLUMN', $result['output']);
    }

