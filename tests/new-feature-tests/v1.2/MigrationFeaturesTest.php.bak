<?php
declare(strict_types=1);

namespace Tests;

use PHPUnit\Framework\TestCase;
use PDO;
use Reut\DB\DataBase;

/**
 * Tests for Migration Commands New Features (v1.2)
 * 
 * Tests cover:
 * 1. Protected columns warning in sync command
 * 2. Standardized error handling
 * 3. Migration rollback command
 * 4. MigrationHelper class utilities
 * 5. Enhanced status command (--table, --json, --summary)
 * 6. Dry-run mode for migrate and sync commands
 * 7. Input validation improvements
 * 8. Migration name uniqueness enhancement
 * 9. Migration validation command
 * 10. Migration export/import commands
 * 
 * Database credentials:
 * - Username: root
 * - Password: root@1234
 * - Database: test_db_two
 */
class MigrationFeaturesTest extends TestCase
{
    private string $testProjectDir;
    private string $testProjectName = 'test_migration_features';
    private string $originalCwd;
    private PDO $pdo;
    private const DB_USER = 'root';
    private const DB_PASS = 'root@1234';
    private const DB_NAME = 'test_db_two';
    private const DB_HOST = 'localhost';

    protected function setUp(): void
    {
        parent::setUp();
        
        // Store original working directory
        $this->originalCwd = getcwd();
        
        // Create a temporary directory for test projects
        $this->testProjectDir = sys_get_temp_dir() . '/reut_migration_test_' . uniqid();
        mkdir($this->testProjectDir, 0755, true);
        chdir($this->testProjectDir);
        
        // Connect to database
        $dsn = "mysql:host=" . self::DB_HOST . ";charset=utf8mb4";
        $this->pdo = new PDO($dsn, self::DB_USER, self::DB_PASS);
        $this->pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
        
        // Create test database
        $this->pdo->exec("DROP DATABASE IF EXISTS " . self::DB_NAME);
        $this->pdo->exec("CREATE DATABASE " . self::DB_NAME);
        $this->pdo->exec("USE " . self::DB_NAME);
        
        // Create config.php
        $this->createConfigFile();
        
        // Create models directory
        mkdir($this->testProjectDir . '/models', 0755, true);
        
        // Create vendor directory structure
        mkdir($this->testProjectDir . '/vendor', 0755, true);
        
        // Create symlink to vendor directory instead of copying (more efficient)
        // Or use the existing vendor from parent directory
        $vendorSource = __DIR__ . '/../../../vendor';
        $vendorTarget = $this->testProjectDir . '/vendor';
        
        // For tests, we'll reference the parent vendor directory
        // Create a simple autoload.php that includes the parent one
        if (file_exists($vendorSource . '/autoload.php')) {
            if (!is_dir($vendorTarget)) {
                mkdir($vendorTarget, 0755, true);
            }
            // Create a wrapper autoload.php that includes the parent
            $autoloadContent = <<<'PHP'
<?php
// Include parent vendor autoloader
require_once __DIR__ . '/../../../../vendor/autoload.php';
PHP;
            file_put_contents($vendorTarget . '/autoload.php', $autoloadContent);
        }
        
        // Copy packages/core for autoloading
        $packagesSource = __DIR__ . '/../../../packages';
        $packagesTarget = $this->testProjectDir . '/packages';
        if (is_dir($packagesSource)) {
            $this->copyDirectory($packagesSource, $packagesTarget);
        }
    }

    protected function tearDown(): void
    {
        // Clean up database
        try {
            $this->pdo->exec("DROP DATABASE IF EXISTS " . self::DB_NAME);
        } catch (\Exception $e) {
            // Ignore cleanup errors
        }
        
        // Restore original directory
        chdir($this->originalCwd);
        
        // Remove test directory
        $this->removeDirectory($this->testProjectDir);
        
        parent::tearDown();
    }

    private function createConfigFile(): void
    {
        $config = <<<'PHP'
<?php
$config = [
    'host' => 'localhost',
    'username' => 'root',
    'password' => 'root@1234',
    'dbname' => 'test_db_two',
    'charset' => 'utf8mb4'
];
PHP;
        file_put_contents($this->testProjectDir . '/config.php', $config);
    }

    private function removeDirectory(string $dir): void
    {
        if (!is_dir($dir)) {
            return;
        }
        
        // Safety check: Never delete vendor directory or project root
        $realDir = realpath($dir);
        $projectRoot = realpath(__DIR__ . '/../../../');
        if ($realDir && $projectRoot && (
            strpos($realDir, $projectRoot . '/vendor') === 0 ||
            $realDir === $projectRoot
        )) {
            return; // Safety: Don't delete vendor or project root
        }
        
        $files = array_diff(scandir($dir), ['.', '..']);
        foreach ($files as $file) {
            $path = $dir . '/' . $file;
            if (is_dir($path)) {
                // Check if it's a symlink before deleting
                if (is_link($path)) {
                    unlink($path);
                } else {
                    $this->removeDirectory($path);
                }
            } else {
                unlink($path);
            }
        }
        rmdir($dir);
    }

    private function createTestModel(string $name, array $columns, array $protectedColumns = []): void
    {
        $tableName = strtolower(str_replace('Table', '', $name));
        $className = $name . 'Table';
        
        // Build columns array for constructor
        $columnsArray = [];
        foreach ($columns as $colName => $colDef) {
            $columnsArray[$colName] = $colDef;
        }
        $columnsExport = var_export($columnsArray, true);
        
        $protectedExport = var_export($protectedColumns, true);
        
        // Use NOWDOC to avoid variable interpolation issues
        $model = <<<'MODEL'
<?php
declare(strict_types=1);

namespace Reut\Models;

use Reut\DB\DataBase;

class CLASSNAME extends DataBase
{
    public function __construct(array $config)
    {
        parent::__construct(
            $config,
            COLUMNS,
            'TABLENAME',
            false,
            0,
            [],
            [],
            PROTECTED
        );
    }
}
MODEL;
        
        // Replace placeholders
        $model = str_replace('CLASSNAME', $className, $model);
        $model = str_replace('TABLENAME', $tableName, $model);
        $model = str_replace('COLUMNS', $columnsExport, $model);
        $model = str_replace('PROTECTED', $protectedExport, $model);
        
        file_put_contents($this->testProjectDir . "/models/{$className}.php", $model);
    }

    private function scaffoldTestProject(): void
    {
        $projectPath = $this->testProjectDir . '/' . $this->testProjectName;
        if (!is_dir($projectPath)) {
            mkdir($projectPath, 0755, true);
        }
        
        // Copy config
        copy($this->testProjectDir . '/config.php', $projectPath . '/config.php');
        
        // Create models directory
        if (!is_dir($projectPath . '/models')) {
            mkdir($projectPath . '/models', 0755, true);
        }
        
        // Copy models from testProjectDir to projectPath if they exist
        if (is_dir($this->testProjectDir . '/models')) {
            $modelFiles = glob($this->testProjectDir . '/models/*.php');
            foreach ($modelFiles as $modelFile) {
                $fileName = basename($modelFile);
                copy($modelFile, $projectPath . '/models/' . $fileName);
            }
        }
        
        // Create vendor symlink or reference
        if (!is_dir($projectPath . '/vendor')) {
            // Create symlink to parent vendor if possible, otherwise copy
            $parentVendor = __DIR__ . '/../../../vendor';
            $parentVendorReal = realpath($parentVendor);
            if ($parentVendorReal && is_dir($parentVendorReal)) {
                @symlink($parentVendorReal, $projectPath . '/vendor');
            }
            // If symlink failed, create wrapper autoload
            if (!is_dir($projectPath . '/vendor')) {
                mkdir($projectPath . '/vendor', 0755, true);
                $autoloadWrapper = <<<'PHP'
<?php
require_once __DIR__ . '/../../../../vendor/autoload.php';
PHP;
                file_put_contents($projectPath . '/vendor/autoload.php', $autoloadWrapper);
            }
        }
        
        // Copy src directory (needed for DatabaseCreator and command files)
        $srcSource = __DIR__ . '/../../../src';
        $srcTarget = $projectPath . '/src';
        if (is_dir($srcSource) && !is_dir($srcTarget)) {
            $this->copyDirectory($srcSource, $srcTarget);
        }
        
        // Copy packages directory
        $packagesSource = __DIR__ . '/../../../packages';
        $packagesTarget = $projectPath . '/packages';
        if (is_dir($packagesSource) && !is_dir($packagesTarget)) {
            $this->copyDirectory($packagesSource, $packagesTarget);
        }
        
        // Create manage.php that properly handles command routing
        $manageContent = <<<'PHP'
<?php
if (!defined('REUT_PROJECT_ROOT')) {
    define('REUT_PROJECT_ROOT', __DIR__);
}
chdir(REUT_PROJECT_ROOT);

// Try multiple autoload paths
$autoloadPaths = [
    REUT_PROJECT_ROOT . '/vendor/autoload.php',
    dirname(dirname(__DIR__)) . '/vendor/autoload.php',
    __DIR__ . '/../../../../vendor/autoload.php',
];

$autoload = null;
foreach ($autoloadPaths as $path) {
    if (file_exists($path)) {
        $autoload = $path;
        break;
    }
}

if (!$autoload) {
    fwrite(STDERR, "Error: Could not find vendor/autoload.php\n");
    exit(1);
}

require $autoload;
require __DIR__ . '/config.php';

use Reut\DB\DatabaseCreator;

// Set up global argv from command line arguments
global $argv;
if (!isset($argv) || empty($argv)) {
    $argv = $_SERVER['argv'] ?? [];
}

DatabaseCreator::Generate();
PHP;
        file_put_contents($projectPath . '/manage.php', $manageContent);
    }
    
    private function runCommand(string $command): array
    {
        $this->scaffoldTestProject();
        $projectPath = $this->testProjectDir . '/' . $this->testProjectName;
        $manageFile = $projectPath . '/manage.php';
        
        $oldCwd = getcwd();
        chdir($projectPath);
        
        $commandParts = explode(' ', $command);
        $cmd = 'php ' . escapeshellarg($manageFile) . ' ' . implode(' ', array_map('escapeshellarg', $commandParts)) . ' 2>&1';
        
        $output = [];
        $returnCode = 0;
        
        try {
            exec($cmd, $output, $returnCode);
        } finally {
            chdir($oldCwd);
        }
        
        return [
            'output' => implode("\n", $output),
            'code' => $returnCode
        ];
    }
    
    private function copySourceFiles(): void
    {
        $srcDir = __DIR__ . '/../../../src';
        $targetDir = $this->testProjectDir . '/src';
        
        if (!is_dir($targetDir)) {
            mkdir($targetDir, 0755, true);
        }
        
        // Copy src directory structure
        if (is_dir($srcDir)) {
            $this->copyDirectory($srcDir, $targetDir);
        }
    }
    
    private function copyDirectory(string $source, string $target): void
    {
        if (!is_dir($target)) {
            mkdir($target, 0755, true);
        }
        
        $iterator = new \RecursiveIteratorIterator(
            new \RecursiveDirectoryIterator($source, \RecursiveDirectoryIterator::SKIP_DOTS),
            \RecursiveIteratorIterator::SELF_FIRST
        );
        
        foreach ($iterator as $item) {
            $sourcePath = $item->getPathname();
            $targetPath = $target . DIRECTORY_SEPARATOR . $iterator->getSubPathName();
            
            if ($item->isDir()) {
                if (!is_dir($targetPath)) {
                    mkdir($targetPath, 0755, true);
                }
            } else {
                // Ensure target directory exists
                $targetDir = dirname($targetPath);
                if (!is_dir($targetDir)) {
                    mkdir($targetDir, 0755, true);
                }
                copy($sourcePath, $targetPath);
            }
        }
    }

    /**
     * Test 1: Protected columns warning in sync command
     */
    public function testProtectedColumnsWarning(): void
    {
        $this->scaffoldTestProject();
        $projectPath = $this->testProjectDir . '/' . $this->testProjectName;
        
        // Create model with protected columns
        $this->createTestModel('Users', [
            'id' => 'INT PRIMARY KEY AUTO_INCREMENT',
            'name' => 'VARCHAR(255)',
        ], ['id', 'created_at']);

        // Create table with created_at column
        $this->pdo->exec("CREATE TABLE users (id INT PRIMARY KEY AUTO_INCREMENT, name VARCHAR(255), created_at TIMESTAMP)");
        
        // Update model to remove created_at (should trigger warning)
        $this->createTestModel('Users', [
            'id' => 'INT PRIMARY KEY AUTO_INCREMENT',
            'name' => 'VARCHAR(255)',
        ], ['id']); // created_at removed but was protected

        // scaffoldTestProject will copy the model, so just run the command
        $result = $this->runCommand('sync');
        
        // Verify sync command runs (may have warnings about protected columns)
        $this->assertIsString($result['output']);
        // Note: Actual interactive confirmation would require mocking STDIN
    }

    /**
     * Test 2: Standardized error handling
     */
    public function testStandardizedErrorHandling(): void
    {
        $this->scaffoldTestProject();
        $projectPath = $this->testProjectDir . '/' . $this->testProjectName;
        
        // Test with invalid database connection
        $config = <<<'PHP'
<?php
$config = [
    'host' => 'invalid_host_that_does_not_exist',
    'username' => 'invalid_user',
    'password' => 'invalid_pass',
    'dbname' => 'invalid_db',
    'charset' => 'utf8mb4'
];
PHP;
        file_put_contents($projectPath . '/config.php', $config);
        
        $result = $this->runCommand('status');
        
        // Should have standardized error message (may be connection error or timeout)
        $this->assertIsString($result['output']);
        // Connection will fail, but should use standardized error handling
        // Exit code should be non-zero (error occurred)
        $this->assertGreaterThan(0, $result['code'], 'Command should exit with error code when connection fails');
    }

    /**
     * Test 3: MigrationHelper - ensureMigrationsTable
     */
    public function testMigrationHelperEnsureMigrationsTable(): void
    {
        // Load MigrationHelper
        require_once __DIR__ . '/../../../src/Utils/MigrationHelper.php';
        
        $configFile = $this->testProjectDir . '/config.php';
        require $configFile;
        if (!isset($config) || !is_array($config)) {
            $this->fail('Config file did not set $config variable properly');
        }
        $baseDb = new DataBase($config);
        $baseDb->connect();
        
        // Ensure migrations table
        \Reut\Utils\MigrationHelper::ensureMigrationsTable($baseDb);
        
        // Verify table exists
        $tables = $baseDb->getTablesList();
        $this->assertContains('migrations', $tables);
    }

    /**
     * Test 4: MigrationHelper - getNextBatch
     */
    public function testMigrationHelperGetNextBatch(): void
    {
        require_once __DIR__ . '/../../../src/Utils/MigrationHelper.php';
        
        $configFile = $this->testProjectDir . '/config.php';
        require $configFile;
        if (!isset($config) || !is_array($config)) {
            $this->fail('Config file did not set $config variable properly');
        }
        $baseDb = new DataBase($config);
        $baseDb->connect();
        
        \Reut\Utils\MigrationHelper::ensureMigrationsTable($baseDb);
        
        // Initially should be 1
        $batch = \Reut\Utils\MigrationHelper::getNextBatch($baseDb);
        $this->assertEquals(1, $batch);
        
        // Insert a migration
        $baseDb->execute(
            "INSERT INTO migrations (name, sql_text, batch) VALUES (:name, :sql_text, :batch)",
            ['name' => 'test_migration_1', 'sql_text' => 'CREATE TABLE test (id INT)', 'batch' => 1]
        );
        
        // Next batch should be 2
        $batch = \Reut\Utils\MigrationHelper::getNextBatch($baseDb);
        $this->assertEquals(2, $batch);
    }

    /**
     * Test 5: MigrationHelper - generateMigrationName with microtime
     */
    public function testMigrationHelperGenerateMigrationName(): void
    {
        require_once __DIR__ . '/../../../src/Utils/MigrationHelper.php';
        
        // Generate multiple names quickly - should be unique
        $names = [];
        for ($i = 0; $i < 10; $i++) {
            $name = \Reut\Utils\MigrationHelper::generateMigrationName('create', 'users');
            $names[] = $name;
            usleep(1000); // Small delay
        }
        
        // All names should be unique
        $uniqueNames = array_unique($names);
        $this->assertCount(count($names), $uniqueNames, 'Migration names should be unique');
        
        // Should contain microtime suffix
        $this->assertMatchesRegularExpression('/create_users_table_\d+_\d+/', $names[0]);
    }

    /**
     * Test 6: MigrationHelper - recordMigration
     */
    public function testMigrationHelperRecordMigration(): void
    {
        require_once __DIR__ . '/../../../src/Utils/MigrationHelper.php';
        
        $configFile = $this->testProjectDir . '/config.php';
        require $configFile;
        if (!isset($config) || !is_array($config)) {
            $this->fail('Config file did not set $config variable properly');
        }
        $baseDb = new DataBase($config);
        $baseDb->connect();
        
        \Reut\Utils\MigrationHelper::ensureMigrationsTable($baseDb);
        
        // Record migration
        $result = \Reut\Utils\MigrationHelper::recordMigration(
            $baseDb,
            'test_migration_record',
            'CREATE TABLE test (id INT)',
            1
        );
        
        $this->assertTrue($result);
        
        // Verify it was recorded
        $migrations = $baseDb->sqlQuery("SELECT * FROM migrations WHERE name = 'test_migration_record'");
        $this->assertNotEmpty($migrations);
        
        // Try to record again - should return false (already exists)
        $result = \Reut\Utils\MigrationHelper::recordMigration(
            $baseDb,
            'test_migration_record',
            'CREATE TABLE test (id INT)',
            1
        );
        
        $this->assertFalse($result);
    }

    /**
     * Test 7: Enhanced status command - JSON output
     */
    public function testStatusCommandJsonOutput(): void
    {
        $configFile = $this->testProjectDir . '/config.php';
        require $configFile;
        if (!isset($config) || !is_array($config)) {
            $this->fail('Config file did not set $config variable properly');
        }
        $baseDb = new DataBase($config);
        $baseDb->connect();
        
        require_once __DIR__ . '/../../../src/Utils/MigrationHelper.php';
        \Reut\Utils\MigrationHelper::ensureMigrationsTable($baseDb);
        
        // Add some migrations
        $baseDb->execute(
            "INSERT INTO migrations (name, sql_text, batch) VALUES (:name, :sql_text, :batch)",
            ['name' => 'test_migration_1', 'sql_text' => 'CREATE TABLE test1 (id INT)', 'batch' => 1]
        );
        
        $result = $this->runCommand('status --json');
        
        // Should be valid JSON
        $json = json_decode($result['output'], true);
        $this->assertNotNull($json, 'Output should be valid JSON');
        $this->assertArrayHasKey('applied', $json);
        $this->assertArrayHasKey('pending', $json);
        $this->assertArrayHasKey('summary', $json);
    }

