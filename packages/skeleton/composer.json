{
    "name": "reut/skeleton",
    "description": "Minimal starter project for the REUT framework.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "reut/core": "@dev",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Reut\\Routers\\": "routers/",
            "Reut\\Models\\": "models/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

