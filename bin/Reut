#!/usr/bin/env php
<?php

// Autoload dependencies - check multiple locations for global vs local install
// When installed globally, Composer creates a symlink in vendor/bin pointing to the package's bin file
// The autoloader is typically in the same vendor directory

$autoloadPaths = [];
$home = getenv('HOME') ?: (getenv('USERPROFILE') ?: getenv('HOMEDRIVE') . getenv('HOMEPATH'));

// Try to find autoloader relative to current file location
$autoloadPaths[] = __DIR__ . '/../../../autoload.php';      // Global: vendor/m4rc/reut_cli/bin -> vendor/autoload.php
$autoloadPaths[] = __DIR__ . '/../../../../autoload.php';   // Alternative global path
$autoloadPaths[] = __DIR__ . '/../vendor/autoload.php';    // Local development

// Try common global Composer locations
if ($home) {
    $autoloadPaths[] = $home . '/.composer/vendor/autoload.php';           // Linux/macOS default
    $autoloadPaths[] = $home . '/.config/composer/vendor/autoload.php';    // Linux XDG
}

// Windows locations
$appData = getenv('APPDATA');
$localAppData = getenv('LOCALAPPDATA');
if ($appData) {
    $autoloadPaths[] = $appData . '/Composer/vendor/autoload.php';
}
if ($localAppData) {
    $autoloadPaths[] = $localAppData . '/Composer/vendor/autoload.php';
}

$autoloadFound = false;
foreach ($autoloadPaths as $autoloadPath) {
    if ($autoloadPath && file_exists($autoloadPath)) {
        require $autoloadPath;
        $autoloadFound = true;
        break;
    }
}

if (!$autoloadFound) {
    fwrite(STDERR, "Error: Composer autoload not found.\n");
    fwrite(STDERR, "Please ensure Composer is installed and run: composer global require m4rc/reut_cli\n");
    fwrite(STDERR, "\nSearched in:\n");
    foreach (array_filter($autoloadPaths) as $path) {
        fwrite(STDERR, "  - " . $path . (file_exists($path) ? " (found)" : "") . "\n");
    }
    exit(1);
}

// Ensure CLI execution
if (php_sapi_name() !== 'cli') {
    exit('This script must be run from the command line.' . PHP_EOL);
}

// Check PHP version
if (version_compare(PHP_VERSION, '7.4.0', '<')) {
    exit('PHP >=7.4 is required. Current version: ' . PHP_VERSION . PHP_EOL);
}

// Get command from arguments
$command = $argv[1] ?? 'help';

// Handle commands
switch ($command) {
    case 'init':
        initCommand($argv);
        break;
    case '-v':
    case 'version':
        echo "Reut CLI v1.3.7" . PHP_EOL;
        exit(0);
    case 'update':
        updateCommand();
        break;
    case 'manage.php':
        $manageFile = getcwd() . DIRECTORY_SEPARATOR . 'manage.php';
        if (!file_exists($manageFile)) {
            echo "Error: manage.php not found in current directory." . PHP_EOL;
            exit(1);
        }
        $args = array_slice($argv, 2);
        $cmd = '"' . PHP_BINARY . '" "' . $manageFile . '" ' . implode(' ', array_map('escapeshellarg', $args));
        passthru($cmd, $exitCode);
        exit($exitCode);
    case 'create':
    case 'status':
    case 'generate:routes':
    case 'generate:model':
    case 'migrate':
    case 'view':
    case 'dev':
    case 'inspect':
    case 'sync':
    case 'rollback':
    case 'validate-migrations':
    case 'export-migrations':
    case 'import-migrations':
        $manageFile = getcwd() . DIRECTORY_SEPARATOR . 'manage.php';
        if (!file_exists($manageFile)) {
            echo "Error: manage.php not found in current directory." . PHP_EOL;
            exit(1);
        }
        $args = array_slice($argv, 1);
        $cmd = '"' . PHP_BINARY . '" "' . $manageFile . '" ' . implode(' ', array_map('escapeshellarg', $args));
        passthru($cmd, $exitCode);
        exit($exitCode);
    case '-h':
    case 'help':
    default:
        echo "Reut CLI Tool v1.3.7" . PHP_EOL;
        echo "Usage: Reut <command> or php manage.php <command>" . PHP_EOL;
        echo "Commands:" . PHP_EOL;
        echo "  init              - Initialize a new REUT project" . PHP_EOL;
        echo "  create            - Initial start of project or add tables from models (alias of migrate)" . PHP_EOL;
        echo "  migrate           - Apply migrations from model definitions (ensures tables exist)" . PHP_EOL;
        echo "  sync              - Reconcile existing tables with models (may drop extra columns)" . PHP_EOL;
        echo "  status            - Check for pending migrations in the models" . PHP_EOL;
        echo "  inspect           - Inspect database schema and sync model definitions" . PHP_EOL;
        echo "  rollback          - Rollback migrations (last batch, specific batch, or migration)" . PHP_EOL;
        echo "  validate-migrations - Validate migration SQL syntax and check for issues" . PHP_EOL;
        echo "  export-migrations - Export migration history to JSON/SQL file" . PHP_EOL;
        echo "  import-migrations - Import migration history from JSON/SQL file" . PHP_EOL;
        echo "  generate:routes   - Generate routes for each model into the route/ folder" . PHP_EOL;
        echo "  generate:model    - Generate model class, pass the model name into the console" . PHP_EOL;
        echo "  dev               - Start the local API dev server (built-in PHP server)" . PHP_EOL;
        echo "  view              - Spin up a local HTML viewer for your models" . PHP_EOL;
        echo "  update            - Update REUT CLI to the latest version" . PHP_EOL;
        echo "  -v, version       - Show CLI version" . PHP_EOL;
        echo "  -h, help          - Show this help message" . PHP_EOL;
        echo "Requirements: PHP (>=7.4) and Composer must be installed." . PHP_EOL;
        break;
}

function initCommand(array $argv): void
{
    echo 'Initializing a new project...' . PHP_EOL;

    // Interactive prompts
    $projectName = prompt('Enter project name (default: myproject): ') ?: 'myproject';
    $dbType = prompt('Enter database type (mysql or postgresql, default: mysql): ') ?: 'mysql';
    if (!in_array($dbType, ['mysql', 'postgresql'])) {
        echo "Error: Invalid database type. Must be 'mysql' or 'postgresql'." . PHP_EOL;
        exit(1);
    }
    $dbName = prompt('Enter database name (default: test_db): ') ?: 'test_db';
    $dbUsername = prompt('Enter database username (default: root): ') ?: 'root';
    $dbPassword = prompt('Enter database password (leave blank if none): ');
    $secretKey = prompt('Enter secret key (default: 12345678): ') ?: '12345678';
    $enableAuth = prompt('Enable built-in authentication? (y/n, default: y): ') ?: 'y';
    $authEnabled = (strtolower($enableAuth) === 'y' || strtolower($enableAuth) === 'yes') ? 'true' : 'false';

    // Create project directory
    $projectDir = getcwd() . DIRECTORY_SEPARATOR . $projectName;
    if (is_dir($projectDir)) {
        echo "Error: Directory already exists: $projectDir" . PHP_EOL;
        exit(1);
    }
    mkdir($projectDir, 0755, true);
    echo "Created project directory: $projectDir" . PHP_EOL;

    $skeletonDir = __DIR__ . '/../packages/skeleton';
    $usingSkeleton = false;
    if (is_dir($skeletonDir)) {
        recursiveCopy($skeletonDir, $projectDir);
        echo "Copied project skeleton" . PHP_EOL;
        $usingSkeleton = true;
    } else {
        echo "Warning: packages/skeleton not found. Falling back to legacy scaffolding." . PHP_EOL;
    }

    // Change to project directory
    chdir($projectDir);

    if (!$usingSkeleton) {
        // Legacy directory creation
        $dirs = ['config/db', 'models', 'routers'];
        foreach ($dirs as $dir) {
            mkdir($dir, 0755, true);
            echo "Created directory: $dir" . PHP_EOL;
        }

        // Copy config/ directory from templates
        $templateConfigDir = __DIR__ . '/../templates/config';
        $destConfigDir = 'config';
        if (is_dir($templateConfigDir)) {
            recursiveCopy($templateConfigDir, $destConfigDir);
            echo "Copied config/ directory" . PHP_EOL;
        } else {
            echo "Warning: templates/config/ not found. Skipping." . PHP_EOL;
        }
    } else {
        // Ensure expected directories exist inside skeleton
        $requiredDirs = ['models', 'routers'];
        foreach ($requiredDirs as $dir) {
            if (!is_dir($dir)) {
                mkdir($dir, 0755, true);
                echo "Created directory: $dir" . PHP_EOL;
            }
        }
    }

    // Copy the viewer scaffolding so the view command can serve HTML docs
    $viewerSourceDir = __DIR__ . '/../src/viewer';
    $viewerDestination = 'viewer';
    if (is_dir($viewerSourceDir)) {
        recursiveCopy($viewerSourceDir, $viewerDestination);
        echo "Copied viewer/ directory" . PHP_EOL;
    } else {
        echo "Warning: src/viewer not found. Viewer command will attempt runtime scaffolding." . PHP_EOL;
    }

    // Copy devserver scaffolding for the dev command
    $devSourceDir = __DIR__ . '/../src/devserver';
    $devDestination = 'devserver';
    if (is_dir($devSourceDir)) {
        recursiveCopy($devSourceDir, $devDestination);
        echo "Copied devserver/ directory" . PHP_EOL;
    } else {
        echo "Warning: src/devserver not found. Dev command will attempt runtime scaffolding." . PHP_EOL;
    }

    // Generate .env file
    $envContent = <<<ENV
SECRET_KEY=$secretKey
DB_USERNAME=$dbUsername
DB_PASSWORD=$dbPassword
DB_NAME=$dbName
DB_TYPE=$dbType
APP_ENV=development
REUT_AUTH_ENABLED=$authEnabled
REUT_DOCS_ENABLED=true

# Rate Limiting Configuration
REUT_RATE_LIMIT_ENABLED=true
REUT_RATE_LIMIT_MAX_REQUESTS=100
REUT_RATE_LIMIT_WINDOW_SECONDS=60

# CSRF Protection Configuration
REUT_CSRF_ENABLED=true
REUT_CSRF_TOKEN_NAME=csrf_token
REUT_CSRF_TOKEN_LENGTH=32
REUT_CSRF_TOKEN_LIFETIME=3600

# Required Field Validation
REUT_STRICT_REQUIRED_VALIDATION=false
ENV;
    file_put_contents('.env', $envContent);
    echo 'Created .env file' . PHP_EOL;

    // Generate config.php
    $configContent = file_exists(__DIR__ . '/../src/configContent.php')
        ? require __DIR__ . '/../src/configContent.php'
        : '<?php return [];';  // Fallback if missing
    file_put_contents('config.php', $configContent);
    echo 'Created config.php' . PHP_EOL;

    // Generate auth.php
    $authContent = file_exists(__DIR__ . '/../src/authContent.php')
        ? require __DIR__ . '/../src/authContent.php'
        : '<?php return [];';  // Fallback if missing
    file_put_contents('auth.php', $authContent);
    echo 'Created auth.php' . PHP_EOL;

    // Generate index.php
    $indexContent = file_exists(__DIR__ . '/../src/indexContent.php')
        ? require __DIR__ . '/../src/indexContent.php'
        : '<?php echo "Hello from MyFramework!";';  // Fallback
    file_put_contents('index.php', $indexContent);
    echo 'Created index.php' . PHP_EOL;

    // Generate manage.php
    $manageContent = <<<PHP
<?php
if (!defined('REUT_PROJECT_ROOT')) {
    define('REUT_PROJECT_ROOT', __DIR__);
}
chdir(REUT_PROJECT_ROOT);
\$autoload = REUT_PROJECT_ROOT . '/vendor/autoload.php';
if (!file_exists(\$autoload)) {
    fwrite(STDERR, "vendor/autoload.php not found. Run `composer install` before using the REUT CLI.\\n");
    exit(1);
}
require \$autoload;
use Reut\DB\DatabaseCreator;
if (!class_exists(DatabaseCreator::class)) {
    fwrite(STDERR, "Composer dependencies missing. Run `composer install` to install reut/core.\\n");
    exit(1);
}
DatabaseCreator::Generate();
PHP;
    file_put_contents('manage.php', $manageContent);
    echo 'Created manage.php' . PHP_EOL;

    $packageSlug = sanitizePackageName($projectName);

    if ($usingSkeleton) {
        $projectComposer = 'composer.json';
        if (file_exists($projectComposer)) {
            $composerData = json_decode(file_get_contents($projectComposer), true);
            if (is_array($composerData)) {
                $composerData['name'] = sprintf('reut/%s', $packageSlug);
                file_put_contents(
                    $projectComposer,
                    json_encode($composerData, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES)
                );
                echo "Configured composer.json" . PHP_EOL;
            }
        }
    } else {
        // Legacy composer.json copy
        $templateComposer = __DIR__ . '/../templates/composer.json';
        if (file_exists($templateComposer)) {
            copy($templateComposer, 'composer.json');
            echo "Copied composer.json" . PHP_EOL;
        } else {
            echo "Warning: templates/composer.json not found. Creating basic composer.json." . PHP_EOL;
            $basicComposer = json_encode([
                'name' => "reut/$packageSlug",
                'require' => ['php' => '>=7.4'],
                'autoload' => ['psr-4' => ["MyFramework\\" => "src/"]]
            ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);
            file_put_contents('composer.json', $basicComposer);
        }
    }

    // Copy .htaccess
    $templateHtaccess = __DIR__ . '/../templates/.htaccess';
    if (file_exists($templateHtaccess)) {
        copy($templateHtaccess, '.htaccess');
        echo "Copied .htaccess" . PHP_EOL;
    } else {
        echo "Warning: templates/.htaccess not found. Skipping .htaccess copy." . PHP_EOL;
    }

    echo PHP_EOL . 'Project initialized successfully!' . PHP_EOL;
    echo 'Next steps:' . PHP_EOL;
    echo '- Run `composer install` in the project directory.' . PHP_EOL;
    echo '- Use `Reut generate:model Users` to create models.' . PHP_EOL;
    echo '- Or use `Reut manage.php generate:model Users` globally.' . PHP_EOL;
}

function prompt(string $message): string
{
    echo $message;
    return trim(fgets(STDIN));
}

function sanitizePackageName(string $name): string
{
    $slug = strtolower($name);
    $slug = preg_replace('/[^a-z0-9]+/', '-', $slug);
    $slug = trim($slug, '-');
    return $slug !== '' ? $slug : 'app';
}

function recursiveCopy(string $source, string $dest): void
{
    if (!is_dir($dest)) {
        mkdir($dest, 0755, true);
    }
    $dir = opendir($source);
    while (($file = readdir($dir)) !== false) {
        if ($file === '.' || $file === '..') {
            continue;
        }
        $srcPath = $source . DIRECTORY_SEPARATOR . $file;
        $destPath = $dest . DIRECTORY_SEPARATOR . $file;
        if (is_dir($srcPath)) {
            recursiveCopy($srcPath, $destPath);
        } else {
            copy($srcPath, $destPath);
        }
    }
    closedir($dir);
}

function updateCommand(): void
{
    echo "Updating REUT CLI..." . PHP_EOL;
    
    // Get current version
    $currentVersion = "1.3.7";
    echo "Current version: v{$currentVersion}" . PHP_EOL;
    
    // Clear composer cache for reut packages (cross-platform)
    echo "Clearing composer cache..." . PHP_EOL;
    $cacheDir = getComposerCacheDir();
    if ($cacheDir && is_dir($cacheDir)) {
        $cacheFiles = glob($cacheDir . DIRECTORY_SEPARATOR . '*reut*');
        $cacheFiles = array_merge($cacheFiles, glob($cacheDir . DIRECTORY_SEPARATOR . '*Reut*'));
        foreach ($cacheFiles as $file) {
            if (is_dir($file)) {
                // Remove directory recursively
                if (PHP_OS_FAMILY === 'Windows') {
                    exec('rmdir /s /q ' . escapeshellarg($file));
                } else {
                    exec('rm -rf ' . escapeshellarg($file));
                }
                echo "  Cleared: " . basename($file) . PHP_EOL;
            }
        }
    }
    
    // Run composer global update
    echo PHP_EOL . "Running composer global update..." . PHP_EOL;
    $cmd = 'composer global update m4rc/reut_cli --no-cache 2>&1';
    passthru($cmd, $exitCode);
    
    if ($exitCode === 0) {
        echo PHP_EOL . "[OK] REUT CLI updated successfully!" . PHP_EOL;
        
        // Check and provide PATH setup instructions
        checkAndSuggestPathSetup();
        
        // Show new version
        echo PHP_EOL . "Verifying installation..." . PHP_EOL;
        $binaryPath = findReutBinary();
        if ($binaryPath) {
            passthru('"' . $binaryPath . '" -v');
        } else {
            echo "Note: 'Reut' command not found in PATH. See PATH setup instructions above." . PHP_EOL;
        }
    } else {
        echo PHP_EOL . "[ERROR] Update failed with exit code: {$exitCode}" . PHP_EOL;
        echo "Try running manually: composer global update m4rc/reut_cli" . PHP_EOL;
        exit(1);
    }
}

/**
 * Check if Reut binary is in PATH and suggest setup if not
 */
function checkAndSuggestPathSetup(): void
{
    $home = getenv('HOME') ?: (getenv('USERPROFILE') ?: getenv('HOMEDRIVE') . getenv('HOMEPATH'));
    if (!$home) {
        return;
    }
    
    // Check which Composer location exists
    $composerHome = null;
    $composerBinPath = null;
    
    $xdgPath = $home . '/.config/composer/vendor/bin';
    $traditionalPath = $home . '/.composer/vendor/bin';
    
    if (is_dir($xdgPath)) {
        $composerHome = $home . '/.config/composer';
        $composerBinPath = $xdgPath;
    } elseif (is_dir($traditionalPath)) {
        $composerHome = $home . '/.composer';
        $composerBinPath = $traditionalPath;
    }
    
    if (!$composerBinPath) {
        return;
    }
    
    // Check if binary exists
    $reutBinary = $composerBinPath . '/Reut';
    if (!file_exists($reutBinary)) {
        return;
    }
    
    // Check if it's in PATH
    $pathEnv = getenv('PATH') ?: '';
    $inPath = strpos($pathEnv, $composerBinPath) !== false;
    
    if (!$inPath) {
        echo PHP_EOL . "⚠️  PATH Setup Required" . PHP_EOL;
        echo "The 'Reut' command is not in your PATH. Add this to your shell configuration:" . PHP_EOL . PHP_EOL;
        
        $shell = getenv('SHELL') ?: '';
        if (strpos($shell, 'fish') !== false) {
            // Fish shell
            echo "For Fish shell, add to ~/.config/fish/config.fish:" . PHP_EOL;
            if ($composerBinPath === $xdgPath) {
                echo "  set -gx PATH \"\$HOME/.config/composer/vendor/bin\" \$PATH" . PHP_EOL;
            } else {
                echo "  set -gx PATH \"\$HOME/.composer/vendor/bin\" \$PATH" . PHP_EOL;
            }
        } else {
            // Bash/Zsh
            $configFile = strpos($shell, 'zsh') !== false ? '~/.zshrc' : '~/.bashrc';
            echo "For Bash/Zsh, add to {$configFile}:" . PHP_EOL;
            if ($composerBinPath === $xdgPath) {
                echo "  export PATH=\"\$HOME/.config/composer/vendor/bin:\$PATH\"" . PHP_EOL;
            } else {
                echo "  export PATH=\"\$HOME/.composer/vendor/bin:\$PATH\"" . PHP_EOL;
            }
        }
        
        echo PHP_EOL . "Then reload your shell or run:" . PHP_EOL;
        if (strpos($shell, 'fish') !== false) {
            echo "  source ~/.config/fish/config.fish" . PHP_EOL;
        } else {
            echo "  source " . (strpos($shell, 'zsh') !== false ? '~/.zshrc' : '~/.bashrc') . PHP_EOL;
        }
        
        echo PHP_EOL . "Or use the full path:" . PHP_EOL;
        echo "  " . $reutBinary . " -v" . PHP_EOL;
    }
}

/**
 * Find the Reut binary in common locations
 */
function findReutBinary(): ?string
{
    $home = getenv('HOME') ?: (getenv('USERPROFILE') ?: getenv('HOMEDRIVE') . getenv('HOMEPATH'));
    if (!$home) {
        return null;
    }
    
    $paths = [
        $home . '/.config/composer/vendor/bin/Reut',
        $home . '/.composer/vendor/bin/Reut',
    ];
    
    // Windows paths
    $appData = getenv('APPDATA');
    $localAppData = getenv('LOCALAPPDATA');
    if ($appData) {
        $paths[] = $appData . '/Composer/vendor/bin/Reut';
    }
    if ($localAppData) {
        $paths[] = $localAppData . '/Composer/vendor/bin/Reut';
    }
    
    foreach ($paths as $path) {
        if (file_exists($path)) {
            return $path;
        }
    }
    
    return null;
}

/**
 * Get the composer cache VCS directory in a cross-platform way.
 */
function getComposerCacheDir(): ?string
{
    // Try to get from composer config first
    $output = [];
    exec('composer global config cache-vcs-dir 2>/dev/null', $output);
    if (!empty($output[0]) && is_dir($output[0])) {
        return $output[0];
    }
    
    // Fall back to platform-specific defaults
    if (PHP_OS_FAMILY === 'Windows') {
        // Windows: %LOCALAPPDATA%\Composer\cache\vcs
        $localAppData = getenv('LOCALAPPDATA');
        if ($localAppData) {
            return $localAppData . '\\Composer\\cache\\vcs';
        }
        // Fallback to APPDATA
        $appData = getenv('APPDATA');
        if ($appData) {
            return $appData . '\\Composer\\cache\\vcs';
        }
    } elseif (PHP_OS_FAMILY === 'Darwin') {
        // macOS: ~/Library/Caches/composer/vcs
        $home = getenv('HOME');
        if ($home) {
            return $home . '/Library/Caches/composer/vcs';
        }
    } else {
        // Linux: ~/.cache/composer/vcs (XDG) or ~/.composer/cache/vcs
        $xdgCache = getenv('XDG_CACHE_HOME');
        if ($xdgCache) {
            return $xdgCache . '/composer/vcs';
        }
        $home = getenv('HOME');
        if ($home) {
            // Try XDG default first
            $xdgPath = $home . '/.cache/composer/vcs';
            if (is_dir($xdgPath)) {
                return $xdgPath;
            }
            // Fall back to old location
            return $home . '/.composer/cache/vcs';
        }
    }
    
    return null;
}